{% liquid
  assign base_url = block.settings.base_url | strip
  assign iframe_height = block.settings.iframe_height | default: 920
  assign iframe_title = block.settings.iframe_title | strip
  if iframe_title == blank
    assign iframe_title = 'Personalizador NOTMID'
  endif
%}

<div class="mgm-personalizados-root" style="width:100%; max-width:100%; overflow: visible;">
  {% if base_url == blank %}
    <p class="mgm-personalizados-placeholder">{{ 'personalizados.configure_base_url' | t }}</p>
  {% else %}
    {% capture iframe_src %}{{ base_url }}{% if base_url contains '?' %}&{% else %}?{% endif %}mgm_embed=1&shop={{ shop.permanent_domain | url_encode }}{% endcapture %}
    {% assign iframe_src = iframe_src | strip %}
    <iframe
      class="mgm-personalizados-iframe"
      data-mgm-initial-height="{{ iframe_height }}"
      src="{{ iframe_src | escape }}"
      title="{{ iframe_title | escape }}"
      loading="eager"
      referrerpolicy="strict-origin-when-cross-origin"
      style="width: 100%; height: {{ iframe_height }}px; border: 0; display: block; overflow: hidden;"
    ></iframe>
    <script>
      (function () {
        var iframe = document.querySelector('.mgm-personalizados-iframe');
        if (!iframe) return;

        var initialHeight = parseInt(iframe.getAttribute('data-mgm-initial-height'), 10);
        if (!Number.isFinite(initialHeight) || initialHeight <= 0) {
          initialHeight = 920;
        }

        var hasDynamicHeight = false;

        function applyIframeHeight(height) {
          if (!Number.isFinite(height) || height <= 0) return;
          var nextHeight = Math.ceil(height);
          if (hasDynamicHeight && Math.abs(nextHeight - iframe.offsetHeight) < 2) return;
          hasDynamicHeight = true;
          iframe.style.height = nextHeight + 'px';
        }

        function normalizeWheelDelta(delta, deltaMode) {
          var magnitude = Number(delta) || 0;
          if (deltaMode === 1) return magnitude * 16;
          if (deltaMode === 2) {
            var viewport = window.innerHeight || document.documentElement.clientHeight || 800;
            return magnitude * viewport;
          }
          return magnitude;
        }

        var pendingWheelX = 0;
        var pendingWheelY = 0;
        var wheelFrameId = 0;
        var maxWheelStepPx = 120;

        function flushWheelScroll() {
          wheelFrameId = 0;
          if (pendingWheelX === 0 && pendingWheelY === 0) return;

          var scrollTarget = document.scrollingElement || document.documentElement;
          if (!scrollTarget) {
            pendingWheelX = 0;
            pendingWheelY = 0;
            return;
          }

          if (typeof scrollTarget.scrollBy === 'function') {
            scrollTarget.scrollBy({
              top: pendingWheelY,
              left: pendingWheelX,
              behavior: 'auto',
            });
          } else {
            scrollTarget.scrollTop += pendingWheelY;
            scrollTarget.scrollLeft += pendingWheelX;
          }

          pendingWheelX = 0;
          pendingWheelY = 0;
        }

        function queueWheelScroll(deltaX, deltaY) {
          var clampedX = Math.sign(deltaX) * Math.min(Math.abs(deltaX), maxWheelStepPx);
          var clampedY = Math.sign(deltaY) * Math.min(Math.abs(deltaY), maxWheelStepPx);
          pendingWheelX += clampedX;
          pendingWheelY += clampedY;
          if (!wheelFrameId) {
            wheelFrameId = window.requestAnimationFrame(flushWheelScroll);
          }
        }

        window.addEventListener('message', function (event) {
          if (!event || event.source !== iframe.contentWindow) return;

          var data = event.data;
          if (!data || data.source !== 'mgm-personalizados') return;

          if (data.type === 'mgm:embed:resize') {
            applyIframeHeight(Number(data.height));
            return;
          }

          if (data.type === 'mgm:embed:wheel') {
            var deltaY = normalizeWheelDelta(Number(data.deltaY) || 0, Number(data.deltaMode) || 0);
            var deltaX = normalizeWheelDelta(Number(data.deltaX) || 0, Number(data.deltaMode) || 0);
            if (deltaY === 0 && deltaX === 0) return;
            queueWheelScroll(deltaX, deltaY);
          }
        });
      })();
    </script>
  {% endif %}
</div>

{% schema %}
{
  "name": "Personalizados",
  "target": "section",
  "settings": [
    {
      "type": "text",
      "id": "base_url",
      "label": "URL base del personalizador",
      "default": "https://personalizados.notmid.ar",
      "placeholder": "https://preview-tu-app.vercel.app",
      "info": "URL pública donde está deployado mgm-front."
    },
    {
      "type": "range",
      "id": "iframe_height",
      "min": 480,
      "max": 1400,
      "step": 20,
      "unit": "px",
      "label": "Alto inicial del iframe",
      "default": 920
    },
    {
      "type": "text",
      "id": "iframe_title",
      "label": "Título del iframe (accesibilidad)",
      "default": "Personalizador NOTMID"
    }
  ]
}
{% endschema %}
